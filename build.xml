<?xml version="1.0" encoding="UTF-8"?>
<project name="FPTU-FA26-PRO192-SE21B-Group02" default="default" basedir=".">
    <description>Builds, tests, and runs the project FPTU-FA26-PRO192-SE21B-Group02.</description>
    <property file="nbproject/project.properties"/>

    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init" description="Compile project sources">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" source="${javac.source}" target="${javac.target}" encoding="${javac.encoding}" includeantruntime="false"/>
    </target>

    <target name="jar" depends="compile" description="Package application JAR">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="jar" description="Run application">
        <java jar="${dist.jar}" fork="true">
            <jvmarg value="-Dfile.encoding=UTF-8"/>
        </java>
    </target>

    <target name="clean" description="Clean build artifacts">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="default" depends="compile,jar"/>
</project>
